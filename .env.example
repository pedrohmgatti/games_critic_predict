# Copie para .env e preencha. O .env nunca vai para o git.
# Chaves da API do IGDB (app da Twitch): https://api-docs.igdb.com/#account-creation
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Opcional: User-Agent com contato, pedido pela política da Wikimedia
BOT_USER_AGENT=
# Opcional: intervalo mínimo entre requisições ao Wikidata, em segundos (padrão 2.0)
WIKIDATA_MIN_INTERVAL=
